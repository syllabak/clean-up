APP_NAME="Net'Express"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Dakar
COMPANY_ID=1

# --- Base de données ---
# Développement / tests : SQLite (fichier hors du dossier public)
DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/database/lavage_test.db
# Production : MySQL / MariaDB
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=lavage_prod
# DB_USERNAME=
# DB_PASSWORD=

# --- Emails (SMTP). MAIL_DRIVER : log | smtp | mail ---
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@example.sn
MAIL_FROM_NAME="Net'Express"

# --- SMS. SMS_DRIVER : log | http ---
SMS_DRIVER=log
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=NetExpress
# Corps JSON envoyé à l'API ; {to}, {message}, {sender} sont remplacés
SMS_BODY_TEMPLATE={"to":"{to}","from":"{sender}","text":"{message}"}

# Jeton pour déclencher les tâches planifiées via HTTP : /cron/run?token=...
CRON_TOKEN=changez-moi
